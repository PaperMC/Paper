<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <suppress checks="MissingJavadoc.*" files="src[\\/]test[\\/]java[^\\/]*[\\/].*"/>
    <suppress checks="JavadocPackage" files="src[\\/]test[\\/]java[^\\/]*[\\/].*"/>

    <!-- Checkstyle currently does not support Markdown-flavored Javadoc comments -->
    <!-- Issue tracking: https://github.com/checkstyle/checkstyle/issues/16100 -->
    <suppress checks="MissingJavadoc.*" files="src[\\/]main[\\/].*"/>
    <suppress checks="JavadocVariable" files="src[\\/]main[\\/].*"/>
</suppressions>
