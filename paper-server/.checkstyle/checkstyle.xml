<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <!--minecraft sources are decompiled and still maintained as patches, so we don't control their format-->
    <module name="BeforeExecutionExclusionFileFilter">
        <property name="fileNamePattern" value="[\\/]paper-server[\\/]src[\\/]minecraft[\\/]"/>
    </module>
    <!--generated sources are written by the generator, so we don't control their format-->
    <module name="BeforeExecutionExclusionFileFilter">
        <property name="fileNamePattern" value="[\\/]paper-server[\\/]src[\\/]generated[\\/]"/>
    </module>
</module>
