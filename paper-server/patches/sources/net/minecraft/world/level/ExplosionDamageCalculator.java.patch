+    // Generic player opt-in, limited to vanilla's classic explosion sources.
+    // Simple/custom calculators, wind charges and modern explosions
+    // retain their own damage and impulse policy.
+    public boolean usesLegacyPhysics(final Explosion explosion, final Entity entity) {
+        if (!(entity instanceof net.minecraft.world.entity.player.Player player && player.legacyCombat)
+            || this.getClass() != ExplosionDamageCalculator.class && this.getClass() != EntityBasedExplosionDamageCalculator.class) return false;
+        Entity source = explosion.getDirectSourceEntity();
+        if (source == null) {
+            return this.getClass() == ExplosionDamageCalculator.class
+                && explosion instanceof ServerExplosion serverExplosion
+                && serverExplosion.getDamageSource().is(net.minecraft.world.damagesource.DamageTypes.BAD_RESPAWN_POINT);
+        }
+        return source instanceof net.minecraft.world.entity.item.PrimedTnt
+            || source instanceof net.minecraft.world.entity.monster.Creeper
+            || source instanceof net.minecraft.world.entity.vehicle.minecart.MinecartTNT
+            || source instanceof net.minecraft.world.entity.projectile.hurtingprojectile.LargeFireball
+            || source instanceof net.minecraft.world.entity.projectile.hurtingprojectile.WitherSkull
+            || source instanceof net.minecraft.world.entity.boss.wither.WitherBoss
+            || source instanceof net.minecraft.world.entity.boss.enderdragon.EndCrystal;
+    }
+
+    public double getEntityDistance(final Explosion explosion, final Entity entity) {
+        double distance = Math.sqrt(entity.distanceToSqr(explosion.center()));
+        return this.usesLegacyPhysics(explosion, entity) ? (double) (float) distance : distance;
+    }
+
+    public Vec3 getEntityKnockbackDirection(final Explosion explosion, final Entity entity) {
