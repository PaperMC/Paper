+            double length = (double) (float) Math.sqrt(delta.lengthSqr());
+            return length == 0.0 ? Vec3.ZERO : new Vec3(delta.x / length, delta.y / length, delta.z / length);
+        }
+        Vec3 origin = entity instanceof net.minecraft.world.entity.item.PrimedTnt ? entity.position() : entity.getEyePosition();
+        return origin.subtract(explosion.center()).normalize();
     }
