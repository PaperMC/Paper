+    // Paper start - Custom region compression formats
+    // Custom formats are stored like Vanilla expects them: the VERSION_CUSTOM id, then the identifier of the format,
+    // which RegionFile#createChunkInputStream reads and looks up with fromCustomId.
+    private static final java.util.Map<net.minecraft.resources.Identifier, RegionFileVersion> CUSTOM_VERSIONS = new java.util.HashMap<>();
+    // zstd without a dictionary. Only read: the "zstd" option writes with the newest dictionary below.
+    public static final RegionFileVersion VERSION_PAPER_ZSTD = registerCustom(
+        net.minecraft.resources.Identifier.fromNamespaceAndPath("paper", "zstd"),
+        null,
+        io.papermc.paper.world.storage.ZstdRegionCompression.NO_DICTIONARY::wrapInput,
+        io.papermc.paper.world.storage.ZstdRegionCompression.NO_DICTIONARY::wrapOutput
+    );
+    // zstd with the first shipped dictionary. Chunks written with a dictionary can only be read with that exact dictionary,
+    // so it must never change: a new dictionary is a new format with its own identifier, and "zstd" moves to it.
+    public static final RegionFileVersion VERSION_PAPER_ZSTD_DICT_1 = registerCustom(
+        net.minecraft.resources.Identifier.fromNamespaceAndPath("paper", "zstd_dict_1"),
+        "zstd",
+        io.papermc.paper.world.storage.ZstdRegionCompression.DICTIONARY_1::wrapInput,
+        io.papermc.paper.world.storage.ZstdRegionCompression.DICTIONARY_1::wrapOutput
+    );
+
+    private static RegionFileVersion registerCustom(
+        final net.minecraft.resources.Identifier customId,
+        final @Nullable String optionName,
+        final RegionFileVersion.StreamWrapper<InputStream> inputWrapper,
+        final RegionFileVersion.StreamWrapper<OutputStream> outputWrapper
+    ) {
+        final RegionFileVersion version = new RegionFileVersion(VERSION_CUSTOM.id, optionName, inputWrapper, out -> {
+            new java.io.DataOutputStream(out).writeUTF(customId.toString()); // DataOutputStream is unbuffered, this goes straight to out
+            return outputWrapper.wrap(out);
+        });
+        CUSTOM_VERSIONS.put(customId, version);
+        if (optionName != null) {
+            VERSIONS_BY_NAME.put(optionName, version);
+        }
+        return version;
+    }
+
+    public static @Nullable RegionFileVersion fromCustomId(final net.minecraft.resources.Identifier customId) {
+        return CUSTOM_VERSIONS.get(customId);
+    }
+
+    // Like wrap, but for VERSION_CUSTOM it first reads the identifier of the format, like RegionFile#createChunkInputStream does.
+    // For code that reads stored chunk data without going through createChunkInputStream, such as the region file header recalculation.
+    public InputStream wrapStoredInput(final InputStream in) throws IOException {
+        if (this.id != VERSION_CUSTOM.id) {
+            return this.wrap(in);
+        }
+        final String type = new java.io.DataInputStream(in).readUTF();
+        final net.minecraft.resources.Identifier customId = net.minecraft.resources.Identifier.tryParse(type);
+        final RegionFileVersion version = customId == null ? null : CUSTOM_VERSIONS.get(customId);
+        if (version == null) {
+            throw new IOException("Unrecognized custom compression " + type);
+        }
+        return version.wrap(in);
+    }
+    // Paper end - Custom region compression formats
