     protected Collection<EntityHitResult> findHitEntities(final Vec3 from, final Vec3 to) {
+        if (this.legacyFlight) {
+            // The caller clips `to` at the first native block intersection.
+            // Use the nearest ray entry, rather than modern center-distance
+            // ordering or a margin which grows with projectile age.
+            EntityHitResult nearest = null;
+            double nearestDistance = Double.MAX_VALUE;
+            AABB search = this.getBoundingBox().expandTowards(this.getDeltaMovement()).inflate(1.0);
+            for (Entity target : this.level().getEntities(this, search, this::canHitEntity)) {
+                Vec3 intersection = legacyClip(target.getBoundingBox().inflate((double) 0.3F), from, to);
+                if (intersection != null) {
+                    double distance = from.distanceToSqr(intersection);
+                    if (distance < nearestDistance) {
+                        nearestDistance = distance;
+                        nearest = new EntityHitResult(target, intersection);
+                    }
+                }
+            }
+            // Return one native result. stepMoveAndHit still dispatches the
+            // cancellable projectile-hit event before native damage and Punch.
+            return nearest == null ? java.util.List.of() : java.util.List.of(nearest);
+        }
         return ProjectileUtil.getManyEntityHitResult(
             this.level(), this, from, to, this.getBoundingBox().expandTowards(this.getDeltaMovement()).inflate(1.0), this::canHitEntity, false
         );
     }
 
