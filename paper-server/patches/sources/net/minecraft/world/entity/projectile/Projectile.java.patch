+    protected static @Nullable Vec3 legacyClip(final AABB bounds, final Vec3 from, final Vec3 to) {
+        Vec3 delta = to.subtract(from);
+        Vec3 nearest = null;
+        double nearestDistance = Double.MAX_VALUE;
+        for (int face = 0; face < 6; face++) {
+            int axis = face / 2;
+            double component = axis == 0 ? delta.x : axis == 1 ? delta.y : delta.z;
+            if (component * component < (double) 1.0E-7F) continue;
+            double origin = axis == 0 ? from.x : axis == 1 ? from.y : from.z;
+            double plane = axis == 0 ? (face % 2 == 0 ? bounds.minX : bounds.maxX)
+                : axis == 1 ? (face % 2 == 0 ? bounds.minY : bounds.maxY)
+                : (face % 2 == 0 ? bounds.minZ : bounds.maxZ);
+            double t = (plane - origin) / component;
+            if (t < 0.0 || t > 1.0) continue;
+            Vec3 candidate = from.add(delta.scale(t));
+            boolean within = axis == 0 ? candidate.y >= bounds.minY && candidate.y <= bounds.maxY && candidate.z >= bounds.minZ && candidate.z <= bounds.maxZ
+                : axis == 1 ? candidate.x >= bounds.minX && candidate.x <= bounds.maxX && candidate.z >= bounds.minZ && candidate.z <= bounds.maxZ
+                : candidate.x >= bounds.minX && candidate.x <= bounds.maxX && candidate.y >= bounds.minY && candidate.y <= bounds.maxY;
+            if (within) {
+                double distance = from.distanceToSqr(candidate);
+                if (distance < nearestDistance) {
+                    nearestDistance = distance;
+                    nearest = candidate;
+                }
+            }
+        }
