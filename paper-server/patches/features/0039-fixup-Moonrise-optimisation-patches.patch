From: Jason Penilla <11360596+jpenilla@users.noreply.github.com>
Date: Thu, 8 Oct 2026 21:11:21 -0700
Subject: [PATCH] fixup! Moonrise optimisation patches

Moonrise: Avoid unused biome palette entries during generation (5634b1f)

diff --git a/net/minecraft/world/level/chunk/LevelChunkSection.java b/net/minecraft/world/level/chunk/LevelChunkSection.java
index e4a99cf554b2cb0b5c39c7a5cb54bfbb77e320ed..41e7d587a678165c02d2c26abcaa9212faf643cb 100644
--- a/net/minecraft/world/level/chunk/LevelChunkSection.java
+++ b/net/minecraft/world/level/chunk/LevelChunkSection.java
@@ -315,18 +315,30 @@ public class LevelChunkSection implements ca.spottedleaf.moonrise.patches.block_
     // CraftBukkit end
 
     public void fillBiomesFromNoise(final BiomeResolver biomeResolver, final int quartMinX, final int quartMinY, final int quartMinZ) {
-        PalettedContainer<Holder<Biome>> newBiomes = this.biomes.recreate();
-        int size = 4;
-
-        for (int x = 0; x < 4; x++) {
-            for (int y = 0; y < 4; y++) {
-                for (int z = 0; z < 4; z++) {
-                    newBiomes.getAndSetUnchecked(x, y, z, biomeResolver.getNoiseBiome(quartMinX + x, quartMinY + y, quartMinZ + z));
+        // Paper start - optimise chunk generation
+        // Seed the palette with the biome at (0, 0, 0) and fill every other position once, so that
+        // every palette entry is present in the generated section. This also keeps uniform sections
+        // in a single-value palette instead of retaining an unused default biome.
+        // Fill in Y/Z/X order, with X varying fastest, to write consecutive storage indices.
+        final Holder<Biome> first = biomeResolver.getNoiseBiome(quartMinX, quartMinY, quartMinZ);
+        final PalettedContainer<Holder<Biome>> newBiomes = new PalettedContainer<>(first, this.biomes.strategy);
+
+        for (int y = 0; y < 4; ++y) {
+            for (int z = 0; z < 4; ++z) {
+                // Skip (0, 0, 0): the initial value already fills it, so do not sample it again.
+                final int startX = y == 0 && z == 0 ? 1 : 0;
+                for (int x = startX; x < 4; ++x) {
+                    // Avoid reading the old value.
+                    newBiomes.set(
+                        (y << 4) | (z << 2) | x,
+                        biomeResolver.getNoiseBiome(quartMinX + x, quartMinY + y, quartMinZ + z)
+                    );
                 }
             }
         }
 
         this.biomes = newBiomes;
+        // Paper end - optimise chunk generation
     }
 
     public LevelChunkSection copy() {
diff --git a/net/minecraft/world/level/chunk/PalettedContainer.java b/net/minecraft/world/level/chunk/PalettedContainer.java
index 0f38eb82954165789e5fa982362925484cba0e53..f49af3efc36d2448e006a721ea4f9a4518aea418 100644
--- a/net/minecraft/world/level/chunk/PalettedContainer.java
+++ b/net/minecraft/world/level/chunk/PalettedContainer.java
@@ -25,7 +25,7 @@ import org.jspecify.annotations.Nullable;
 public class PalettedContainer<T> implements PaletteResize<T>, PalettedContainerRO<T> {
     private static final int MIN_PALETTE_BITS = 0;
     public volatile PalettedContainer.Data<T> data; // Paper - optimise collisions - public
-    private final Strategy<T> strategy;
+    public final Strategy<T> strategy; // Paper - optimise chunk generation - public
     private final T @Nullable [] presetValues; // Paper - Anti-Xray - Add preset values
     //private final ThreadingDetector threadingDetector = new ThreadingDetector("PalettedContainer"); // Paper - unused
 
@@ -215,7 +215,7 @@ public class PalettedContainer<T> implements PaletteResize<T>, PalettedContainer
         }
     }
 
-    private void set(final int index, final T value) {
+    public void set(final int index, final T value) { // Paper - optimise chunk generation - public
         int id = this.data.palette.idFor(value, this);
         this.data.storage.set(index, id);
     }
