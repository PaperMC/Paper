From: CozREV <kristianafg@proton.me>
Date: Tue, 15 Sep 2026 16:40:16 +0200
Subject: [PATCH] Add ignoreEmptyCrystalsToRespawn flag


diff --git a/net/minecraft/world/level/dimension/end/EnderDragonFight.java b/net/minecraft/world/level/dimension/end/EnderDragonFight.java
index 26926083cbb2722bb5fbcbc81bcc44a99799ad9e..f3362e9890f1e8f9519b2068313d6cdb98be6648 100644
--- a/net/minecraft/world/level/dimension/end/EnderDragonFight.java
+++ b/net/minecraft/world/level/dimension/end/EnderDragonFight.java
@@ -103,6 +103,7 @@ public class EnderDragonFight extends SavedData {
     public @Nullable DragonRespawnStage respawnStage;
     private int respawnTime;
     public List<EntityReference<EndCrystal>> respawnCrystals;
+    public boolean ignoreEmptyCrystalsToRespawn = false; // Paper
     public static final Codec<EnderDragonFight> CODEC = RecordCodecBuilder.create(
         i -> i.group(
                 ExtraCodecs.optionalAlwaysPresentFieldOf(Codec.BOOL, "needs_state_scanning", true).forGetter(fight -> fight.needsStateScanning),
@@ -200,11 +201,10 @@ public class EnderDragonFight extends SavedData {
                     .map(e -> e.getEntity(this.level, EndCrystal.class))
                     .filter(Objects::nonNull)
                     .toList();
-                if (respawnCrystals.isEmpty()) {
+                if (respawnCrystals.isEmpty() && !this.ignoreEmptyCrystalsToRespawn) { // Paper
                     this.abortRespawnSequence();
                     return;
                 }
-
                 this.respawnStage.tick(this.level, this, respawnCrystals, this.respawnTime++);
                 this.setDirty();
             }
@@ -282,6 +282,7 @@ public class EnderDragonFight extends SavedData {
         if (stage == DragonRespawnStage.END) {
             this.respawnStage = null;
             this.dragonKilled = false;
+            this.ignoreEmptyCrystalsToRespawn = false; // Paper
             EnderDragon dragon = this.createNewDragon();
             if (dragon != null) {
                 for (ServerPlayer player : this.dragonEvent.getPlayers()) {
