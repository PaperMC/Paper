From: Jason Penilla <11360596+jpenilla@users.noreply.github.com>
Date: Wed, 7 Oct 2026 18:24:10 -0700
Subject: [PATCH] fixup! Moonrise optimisation patches


diff --git a/net/minecraft/world/level/chunk/ChunkAccess.java b/net/minecraft/world/level/chunk/ChunkAccess.java
index 30280cd105795a63ea7201fce3494c80b852142e..39ea7198f3bbe4525e686504887e0074de80854d 100644
--- a/net/minecraft/world/level/chunk/ChunkAccess.java
+++ b/net/minecraft/world/level/chunk/ChunkAccess.java
@@ -132,14 +132,14 @@ public abstract class ChunkAccess implements LightChunk, StructureAccess, BiomeR
     private final int minSection;
     private final int maxSection;
     // Paper end - get block chunk optimisation
-    // Paper start - optimise heightmap access
+    // Paper start - getblock optimisations - cache world height/sections
     private final int minY;
     private final int height;
     private final int maxY;
     private final int minSectionY;
     private final int maxSectionY;
     private final int sectionsCount;
-    // Paper end - optimise heightmap access
+    // Paper end - getblock optimisations - cache world height/sections
 
     public ChunkAccess(
         final ChunkPos chunkPos,
@@ -150,14 +150,14 @@ public abstract class ChunkAccess implements LightChunk, StructureAccess, BiomeR
         final LevelChunkSection @Nullable [] sections,
         final @Nullable BlendingData blendingData
     ) {
-        // Paper start - optimise heightmap access
+        // Paper start - getblock optimisations - cache world height/sections
         this.minY = levelHeightAccessor.getMinY();
         this.height = levelHeightAccessor.getHeight();
         this.maxY = this.minY + this.height - 1;
         this.minSectionY = this.minY >> 4;
         this.maxSectionY = this.maxY >> 4;
         this.sectionsCount = this.maxSectionY - this.minSectionY + 1;
-        // Paper end - optimise heightmap access
+        // Paper end - getblock optimisations - cache world height/sections
         this.locX = chunkPos.x(); this.locZ = chunkPos.z(); // Paper - reduce need for field lookups
         this.chunkPos = chunkPos; this.coordinateKey = ChunkPos.pack(this.locX, this.locZ); // Paper - cache long key
         this.upgradeData = upgradeData;
@@ -481,15 +481,15 @@ public abstract class ChunkAccess implements LightChunk, StructureAccess, BiomeR
 
     @Override
     public int getMinY() {
-        return this.minY; // Paper - optimise heightmap access
+        return this.minY; // Paper - getblock optimisations - cache world height/sections
     }
 
     @Override
     public int getHeight() {
-        return this.height; // Paper - optimise heightmap access
+        return this.height; // Paper - getblock optimisations - cache world height/sections
     }
 
-    // Paper start - optimise heightmap access
+    // Paper start - getblock optimisations - cache world height/sections
     @Override
     public int getMaxY() {
         return this.maxY;
@@ -539,7 +539,7 @@ public abstract class ChunkAccess implements LightChunk, StructureAccess, BiomeR
     public int getSectionYFromSectionIndex(final int sectionIdx) {
         return sectionIdx + this.minSectionY;
     }
-    // Paper end - optimise heightmap access
+    // Paper end - getblock optimisations - cache world height/sections
 
     @Deprecated
     public BiomeGenerationSettings carverBiome(final Supplier<BiomeGenerationSettings> source) {
