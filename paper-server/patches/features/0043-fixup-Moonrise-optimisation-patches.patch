Subject: [PATCH] fixup! Moonrise optimisation patches


diff --git a/net/minecraft/world/level/levelgen/structure/templatesystem/AllOfRuleTest.java b/net/minecraft/world/level/levelgen/structure/templatesystem/AllOfRuleTest.java
index d63fd86f1fd90a00eb35dc124879d8ee1d59ad5a..39d459593cba39005ec7f1b56fc67fa9e16e7965 100644
--- a/net/minecraft/world/level/levelgen/structure/templatesystem/AllOfRuleTest.java
+++ b/net/minecraft/world/level/levelgen/structure/templatesystem/AllOfRuleTest.java
@@ -9,14 +9,16 @@ import net.minecraft.world.level.block.state.BlockState;
 public class AllOfRuleTest extends RuleTest {
     public static final MapCodec<AllOfRuleTest> CODEC = RuleTest.CODEC.listOf().fieldOf("rules").xmap(AllOfRuleTest::new, t -> t.rules);
     private final List<RuleTest> rules;
+    private final RuleTest[] rulesArray; // Paper - optimise chunk generation
 
     public AllOfRuleTest(final List<RuleTest> rules) {
         this.rules = rules;
+        this.rulesArray = rules.toArray(new RuleTest[0]); // Paper - optimise chunk generation
     }
 
     @Override
     public boolean test(final BlockState blockState, final BlockPos pos, final RandomSource random) {
-        for (RuleTest rule : this.rules) {
+        for (final RuleTest rule : this.rulesArray) { // Paper - optimise chunk generation
             if (!rule.test(blockState, pos, random)) {
                 return false;
             }
