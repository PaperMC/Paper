+        // Paper start - optimise chunk generation
+        private final ThreadLocal<ca.spottedleaf.moonrise.patches.chunk_gen.RTreeLeafDistance<T>> lastReturned = ThreadLocal.withInitial(() -> {
+            return new ca.spottedleaf.moonrise.patches.chunk_gen.RTreeLeafDistance<>(null, Long.MAX_VALUE);
