+        for (final Beardifier.Rigid rigid : this.piecesArray) {
+            final BoundingBox box = rigid.box();
+            final int groundLevelDelta = rigid.groundLevelDelta();
+            final int dx = Math.max(0, Math.max(box.minX() - blockX, blockX - box.maxX()));
