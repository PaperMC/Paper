+            final int groundY = box.minY() + groundLevelDelta;
+            final int dyToGround = blockY - groundY;
+
+            switch (rigid.terrainAdjustment()) {
+                case NONE: {
+                    continue;
+                }
+                case BURY: {
+                    noiseValue += getBuryContribution((float)dx, (float)dyToGround / 2.0f, (float)dz);
