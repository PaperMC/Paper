diff --git a/ca/spottedleaf/moonrise/patches/starlight/light/SWMRNibbleArray.java b/ca/spottedleaf/moonrise/patches/starlight/light/SWMRNibbleArray.java
index 240416aba0ad4649e1db401aff2565f972f5ca11..2376701e7b9d22fa6048edff4c49f5847930bcb1 100644
--- a/ca/spottedleaf/moonrise/patches/starlight/light/SWMRNibbleArray.java
+++ b/ca/spottedleaf/moonrise/patches/starlight/light/SWMRNibbleArray.java
@@ -58,6 +58,20 @@ public final class SWMRNibbleArray {
     private byte[] storageUpdating;
     private boolean updatingDirty; // only returns whether storageUpdating is dirty
     private volatile byte[] storageVisible;
+    // Paper start - Don't re-save chunks that were only loaded
+    // Nibbles created by initNibble with initRemovedNibbles only live in a light engine's nibble cache for one operation.
+    // They are never attached to a chunk, so changes to them are not visible and are never saved.
+    private boolean cacheOnly;
+
+    public SWMRNibbleArray markCacheOnly() {
+        this.cacheOnly = true;
+        return this;
+    }
+
+    public boolean isCacheOnly() {
+        return this.cacheOnly;
+    }
+    // Paper end - Don't re-save chunks that were only loaded
 
     public SWMRNibbleArray() {
         this(null, false); // lazy init
@@ -335,7 +349,17 @@ public final class SWMRNibbleArray {
             return false;
         }
 
+        final boolean changed; // Paper - Don't re-save chunks that were only loaded
         synchronized (this) {
+            // Paper start - Don't re-save chunks that were only loaded
+            // Only report a change if the visible state or data actually differs afterwards. Light updates can lower a value
+            // and propagate it back up to where it was, which marks the nibble dirty without changing anything.
+            final boolean uninitialised = this.stateUpdating == INIT_STATE_NULL || this.stateUpdating == INIT_STATE_UNINIT;
+            final byte[] oldVisible = this.storageVisible;
+            final byte[] newVisible = uninitialised ? null : this.storageUpdating;
+            changed = this.stateUpdating != this.stateVisible
+                || (newVisible == null ? oldVisible != null : (oldVisible == null || (newVisible != oldVisible && !Arrays.equals(newVisible, oldVisible))));
+            // Paper end - Don't re-save chunks that were only loaded
             if (this.stateUpdating == INIT_STATE_NULL || this.stateUpdating == INIT_STATE_UNINIT) {
                 this.storageVisible = null;
             } else {
@@ -356,7 +380,7 @@ public final class SWMRNibbleArray {
             this.stateVisible = this.stateUpdating;
         }
 
-        return true;
+        return changed; // Paper - Don't re-save chunks that were only loaded
     }
 
     // operation type: visible
