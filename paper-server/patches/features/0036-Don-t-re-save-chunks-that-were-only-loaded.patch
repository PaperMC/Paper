+++ b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/task/ChunkLoadTask.java
@@ -339,6 +339,10 @@ public final class ChunkLoadTask extends ChunkProgressionTask {
             }
 
             try {
+                // Paper start - Don't re-save chunks that were only loaded
+                // check before converting, the converters may modify the tag in place
+                final boolean upgraded = net.minecraft.nbt.NbtUtils.getDataVersion(data, -1) < net.minecraft.SharedConstants.getCurrentVersion().dataVersion().version();
+                // Paper end - Don't re-save chunks that were only loaded
                 // run converters
                 final CompoundTag converted = this.world.getChunkSource().chunkMap.upgradeChunkTag(data);
 
@@ -356,6 +360,12 @@ public final class ChunkLoadTask extends ChunkProgressionTask {
                     this.world, this.world.getPoiManager(), this.world.getChunkSource().chunkMap.storageInfo(),
                     new ChunkPos(this.chunkX, this.chunkZ)
                 );
+                // Paper start - Don't re-save chunks that were only loaded
+                if (upgraded && chunk != null) {
+                    // the converted data differs from what is on disk, write it back in the current format
+                    chunk.markUnsaved();
+                }
+                // Paper end - Don't re-save chunks that were only loaded
 
                 return new TaskResult<>(new ReadChunk(chunk, chunkData), null);
             } catch (final Throwable thr2) {
