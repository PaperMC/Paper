@@ -380,17 +380,28 @@ public record SerializableChunkData(
         }
         // CraftBukkit end
 
+        // Paper start - Don't re-save chunks that were only loaded
+        // Tracks whether loading changed anything that would be written back, see below
+        boolean changedOnLoad = !this.lightCorrect || this.blendingData != null;
+        // Paper end - Don't re-save chunks that were only loaded
         chunk.setLightCorrect(this.lightCorrect);
         Set<Heightmap.Types> toPrime = EnumSet.copyOf(chunk.getPersistedStatus().heightmapsAfter());
 
         for (Entry<Heightmap.Types, long[]> entry : this.heightmaps.entrySet()) {
