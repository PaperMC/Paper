             chunk.setHeightmap(entry.getKey(), entry.getValue());
             toPrime.remove(entry.getKey());
         }
 
+        changedOnLoad |= !toPrime.isEmpty(); // Paper - Don't re-save chunks that were only loaded
         Heightmap.primeHeightmaps(chunk, toPrime);
-        chunk.setAllStarts(unpackStructureStart(StructurePieceSerializationContext.fromLevel(level), this.structureData, level.getSeed()));
-        chunk.setAllReferences(unpackStructureReferences(level.registryAccess(), pos, this.structureData));
+        // Paper start - Don't re-save chunks that were only loaded
+        final Map<Structure, StructureStart> starts = unpackStructureStart(StructurePieceSerializationContext.fromLevel(level), this.structureData, level.getSeed());
+        final Map<Structure, LongSet> references = unpackStructureReferences(level.registryAccess(), pos, this.structureData);
+        changedOnLoad |= starts.size() != this.structureData.getCompoundOrEmpty("starts").size() || structureReferencesChanged(this.structureData, references);
