         for (int sectionIndex = 0; sectionIndex < this.postProcessingSections.length; sectionIndex++) {
             ShortList postProcessingSection = this.postProcessingSections[sectionIndex];
@@ -400,6 +411,14 @@ public record SerializableChunkData(
         }
 
         if (chunkType == ChunkType.LEVELCHUNK) {
+            // Paper start - Don't re-save chunks that were only loaded
+            // The setters above (light flag, structures, PDC) mark the chunk unsaved even though they only restore what is on disk.
+            // If nothing was changed while loading, the freshly created chunk matches its saved data and does not need to be written back.
+            // Proto chunks are left alone, they are marked unsaved by setPersistedStatus anyway.
+            if (!changedOnLoad) {
+                chunk.clearUnsavedAfterLoad();
+            }
+            // Paper end - Don't re-save chunks that were only loaded
             return this.loadStarlightLightData(level, new ImposterProtoChunk((LevelChunk)chunk, false)); // Paper - starlight
         }
 
@@ -706,6 +725,32 @@ public record SerializableChunkData(
         return outmap;
     }
 
+    // Paper start - Don't re-save chunks that were only loaded
+    // unpackStructureReferences drops unknown structures, out of range and duplicate references, and packStructureData skips empty sets
+    private static boolean structureReferencesChanged(final CompoundTag structureData, final Map<Structure, LongSet> references) {
+        final CompoundTag referencesTag = structureData.getCompoundOrEmpty("References");
+        int keptEntries = 0;
+        long keptReferences = 0L;
+        for (final LongSet structureReferences : references.values()) {
+            if (!structureReferences.isEmpty()) {
+                keptEntries++;
+                keptReferences += structureReferences.size();
+            }
+        }
+
+        if (keptEntries != referencesTag.size()) {
+            return true;
+        }
+
+        long savedReferences = 0L;
+        for (final String key : referencesTag.keySet()) {
+            savedReferences += referencesTag.getLongArray(key).map(array -> array.length).orElse(0);
+        }
+
+        return savedReferences != keptReferences;
+    }
+    // Paper end - Don't re-save chunks that were only loaded
+
     private static Map<Structure, LongSet> unpackStructureReferences(final RegistryAccess registryAccess, final ChunkPos pos, final CompoundTag tag) {
         Map<Structure, LongSet> outmap = Maps.newHashMap();
         Registry<Structure> structuresRegistry = registryAccess.lookupOrThrow(Registries.STRUCTURE);
