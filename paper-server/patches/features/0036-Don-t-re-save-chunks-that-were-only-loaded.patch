                 lightAccess.onLightUpdate(this.skylightPropagator ? LightLayer.SKY : LightLayer.BLOCK, SectionPos.of(chunkX, chunkY, chunkZ));
             }
         }
diff --git a/net/minecraft/world/level/chunk/ChunkAccess.java b/net/minecraft/world/level/chunk/ChunkAccess.java
index 39ea7198f3bbe4525e686504887e0074de80854d..27bd634e65eb8a304b71f4db043aa529af4051fa 100644
--- a/net/minecraft/world/level/chunk/ChunkAccess.java
+++ b/net/minecraft/world/level/chunk/ChunkAccess.java
@@ -346,7 +346,7 @@ public abstract class ChunkAccess implements LightChunk, StructureAccess, BiomeR
     }
 
     public boolean tryMarkSaved() {
-        if (this.unsaved) {
+        if (this.unsaved || this.persistentDataContainer.dirty()) { // Paper - Don't re-save chunks that were only loaded; also clear a dirty pdc on its own
             this.unsaved = false;
             this.persistentDataContainer.dirty(false); // CraftBukkit - SPIGOT-6814: chunk was saved, pdc is no longer dirty
             return true;
@@ -355,6 +355,16 @@ public abstract class ChunkAccess implements LightChunk, StructureAccess, BiomeR
         }
     }
 
+    // Paper start - Don't re-save chunks that were only loaded
+    /**
+     * Only for a chunk that was just created from its saved data, before anything else could modify it.
+     */
+    public void clearUnsavedAfterLoad() {
+        this.unsaved = false;
+        this.persistentDataContainer.dirty(false);
+    }
+    // Paper end - Don't re-save chunks that were only loaded
+
     public boolean isUnsaved() {
         return this.unsaved || this.persistentDataContainer.dirty(); // CraftBukkit - SPIGOT-6814: chunk is unsaved if pdc was mutated
     }
diff --git a/net/minecraft/world/level/chunk/LevelChunk.java b/net/minecraft/world/level/chunk/LevelChunk.java
index 76dae652c910e36c860791a8285bd9fee466d5b9..6aedce5c6b7d00eda4d929d5f0f24d65cf5d410f 100644
