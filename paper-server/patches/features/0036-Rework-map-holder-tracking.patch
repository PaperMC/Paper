+    private void checkInventoryMaps() {
+        // checkStillInInventory must not modify inventoryMaps, this iterator does not detect concurrent modification
+        for (final java.util.Iterator<net.minecraft.world.level.saveddata.maps.MapItemSavedData> iterator = this.inventoryMaps.iterator(); iterator.hasNext();) {
