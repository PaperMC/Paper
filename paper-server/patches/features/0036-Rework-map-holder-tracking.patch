+
+    // For players whose tick is skipped (spectators touching unloaded chunks): keeps their markers and holders up to date
+    // without a full inventory tick, which would also update held maps from the world
+    public void tickInventoryMapsWithoutInventoryTick() {
+        if (this.inventoryMaps.isEmpty()) {
+            return;
+        }
+        for (int i = 0; i < this.inventory.getContainerSize(); i++) {
+            this.tickInventoryMap(this.inventory.getItem(i));
+        }
+        this.checkInventoryMaps();
+    }
