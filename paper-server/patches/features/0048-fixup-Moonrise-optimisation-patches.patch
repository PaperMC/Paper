diff --git a/net/minecraft/world/level/chunk/ChunkAccess.java b/net/minecraft/world/level/chunk/ChunkAccess.java
index 03694d0e9f154bdbf5635bbd1c90b02a2f28af9f..30280cd105795a63ea7201fce3494c80b852142e 100644
--- a/net/minecraft/world/level/chunk/ChunkAccess.java
+++ b/net/minecraft/world/level/chunk/ChunkAccess.java
@@ -132,6 +132,14 @@ public abstract class ChunkAccess implements LightChunk, StructureAccess, BiomeR
     private final int minSection;
     private final int maxSection;
     // Paper end - get block chunk optimisation
+    // Paper start - optimise heightmap access
+    private final int minY;
+    private final int height;
+    private final int maxY;
+    private final int minSectionY;
+    private final int maxSectionY;
+    private final int sectionsCount;
+    // Paper end - optimise heightmap access
 
     public ChunkAccess(
         final ChunkPos chunkPos,
@@ -142,6 +150,14 @@ public abstract class ChunkAccess implements LightChunk, StructureAccess, BiomeR
         final LevelChunkSection @Nullable [] sections,
         final @Nullable BlendingData blendingData
     ) {
+        // Paper start - optimise heightmap access
+        this.minY = levelHeightAccessor.getMinY();
+        this.height = levelHeightAccessor.getHeight();
+        this.maxY = this.minY + this.height - 1;
+        this.minSectionY = this.minY >> 4;
+        this.maxSectionY = this.maxY >> 4;
+        this.sectionsCount = this.maxSectionY - this.minSectionY + 1;
+        // Paper end - optimise heightmap access
         this.locX = chunkPos.x(); this.locZ = chunkPos.z(); // Paper - reduce need for field lookups
         this.chunkPos = chunkPos; this.coordinateKey = ChunkPos.pack(this.locX, this.locZ); // Paper - cache long key
         this.upgradeData = upgradeData;
@@ -465,14 +481,66 @@ public abstract class ChunkAccess implements LightChunk, StructureAccess, BiomeR
 
     @Override
     public int getMinY() {
-        return this.levelHeightAccessor.getMinY();
+        return this.minY; // Paper - optimise heightmap access
     }
 
     @Override
     public int getHeight() {
-        return this.levelHeightAccessor.getHeight();
+        return this.height; // Paper - optimise heightmap access
     }
 
+    // Paper start - optimise heightmap access
+    @Override
+    public int getMaxY() {
+        return this.maxY;
+    }
+
+    @Override
+    public int getSectionsCount() {
+        return this.sectionsCount;
+    }
+
+    @Override
+    public int getMinSectionY() {
+        return this.minSectionY;
+    }
+
+    @Override
+    public int getMaxSectionY() {
+        return this.maxSectionY;
+    }
+
+    @Override
+    public boolean isInsideBuildHeight(final int blockY) {
+        return blockY >= this.minY && blockY <= this.maxY;
+    }
+
+    @Override
+    public boolean isOutsideBuildHeight(final BlockPos pos) {
+        return this.isOutsideBuildHeight(pos.getY());
+    }
+
+    @Override
+    public boolean isOutsideBuildHeight(final int blockY) {
+        return blockY < this.minY || blockY > this.maxY;
+    }
+
+    @Override
+    public int getSectionIndex(final int blockY) {
+        return (blockY >> 4) - this.minSectionY;
+    }
+
+    @Override
+    public int getSectionIndexFromSectionY(final int sectionY) {
+        return sectionY - this.minSectionY;
+    }
+
+    @Override
+    public int getSectionYFromSectionIndex(final int sectionIdx) {
+        return sectionIdx + this.minSectionY;
+    }
+    // Paper end - optimise heightmap access
+
     @Deprecated
     public BiomeGenerationSettings carverBiome(final Supplier<BiomeGenerationSettings> source) {
         if (this.carverBiomeSettings == null) {
diff --git a/net/minecraft/world/level/levelgen/Heightmap.java b/net/minecraft/world/level/levelgen/Heightmap.java
index 50827f91da97201264e7da29b958ad6297da6540..22990ffcb40304279530462a72c489e8e1207e08 100644
--- a/net/minecraft/world/level/levelgen/Heightmap.java
+++ b/net/minecraft/world/level/levelgen/Heightmap.java
@@ -30,6 +30,17 @@ public class Heightmap {
     private final BitStorage data;
     private final Predicate<BlockState> isOpaque;
     private final ChunkAccess chunk;
+    // Paper start - optimise heightmap access
+    private static final ThreadLocal<int[]> TEMP_ARRAY = ThreadLocal.withInitial(() -> {
+        return new int[16*16];
+    });
+
+    // note: as it stands, max block height is currently 4096
+    //       this will fit inside char
+    //       additionally, for normal worlds (height = 384 or 256) the number of
+    //       bytes used in the storage is 296 compared to this (512)
+    private final char[] heightmapRaw = new char[16*16];
+    // Paper end - optimise heightmap access
 
     public Heightmap(final ChunkAccess chunk, final Heightmap.Types heightmapType) {
         this.isOpaque = heightmapType.isOpaque();
@@ -117,17 +128,29 @@ public class Heightmap {
     }
 
     private int getFirstAvailable(final int index) {
-        return this.data.get(index) + this.chunk.getMinY();
+        return (int)this.heightmapRaw[index] + this.chunk.getMinY(); // Paper - optimise heightmap access
     }
 
     private void setHeight(final int x, final int z, final int height) {
-        this.data.set(getIndex(x, z), height - this.chunk.getMinY());
+        // Paper start - optimise heightmap access
+        final int index = getIndex(x, z);
+        final int value = height - this.chunk.getMinY();
+        this.data.set(index, value);
+        this.heightmapRaw[index] = (char)value;
+        // Paper end - optimise heightmap access
     }
 
     public void setRawData(final ChunkAccess chunk, final Heightmap.Types type, final long[] data) {
         long[] rawData = this.data.getRaw();
         if (rawData.length == data.length) {
             System.arraycopy(data, 0, rawData, 0, data.length);
+            // Paper start - optimise heightmap access
+            final int[] tmp = TEMP_ARRAY.get();
+            this.data.unpack(tmp);
+            for (int i = 0, len = tmp.length; i < len; ++i) {
+                this.heightmapRaw[i] = (char)tmp[i];
+            }
+            // Paper end - optimise heightmap access
         } else {
             LOGGER.warn("Ignoring heightmap data for chunk {}, size does not match; expected: {}, got: {}", chunk.getPos(), rawData.length, data.length);
             primeHeightmaps(chunk, EnumSet.of(type));
@@ -139,7 +162,7 @@ public class Heightmap {
     }
 
     private static int getIndex(final int x, final int z) {
-        return x + z * 16;
+        return x | (z << 4); // Paper - optimise heightmap access
     }
 
     public enum Types implements StringRepresentable {
