     }
 
-    // Paper start - optimise chunk generation
-    // Provide a buffer allocator to the MaterialRuleContext to significantly reduce memory allocations
     @Deprecated
     public Optional<BlockState> topMaterial(
         final MaterialRule ruleSource,
@@ -266,33 +246,13 @@ public class MaterialSystem {
         final DensitySamplerSet densitySamplers,
         final BlockPos pos,
         final boolean underFluid
