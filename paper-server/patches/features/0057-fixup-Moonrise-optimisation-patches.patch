-    @Deprecated
-    private Optional<BlockState> topMaterial( // Paper - optimise chunk generation - private
-        final ca.spottedleaf.moonrise.patches.chunk_gen.buffer_alloc.ThreadLocalFixedDensityBufferCache allocator, // Paper - optimise chunk generation
-        final MaterialRule ruleSource,
-        final RandomState randomState,
-        final WorldGenerationContext worldGenerationContext,
-        final Function<BlockPos, Holder<Biome>> biomeGetter,
-        final ChunkAccess chunk,
