-        BUFFERS_FOR_TOP_MATERIAL.set(null);
-        try {
-            return this.topMaterial(allocator, ruleSource, randomState, worldGenerationContext, biomeGetter, chunk, densitySamplers, pos, underFluid);
-        } finally {
-            allocator.release();
-            BUFFERS_FOR_TOP_MATERIAL.set(allocator);
-        }
-    }
-    // Paper end - optimise chunk generation
