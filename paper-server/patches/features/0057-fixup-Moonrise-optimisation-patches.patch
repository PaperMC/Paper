-        context.moonrise$setDensityBufferAllocator(allocator); // Paper - optimise chunk generation
+        // Paper start - optimise chunk generation - provide a buffer allocator to significantly reduce memory allocations
+        context.moonrise$setDensityBufferAllocator(BUFFERS_FOR_TOP_MATERIAL.get().acquire());
+        BUFFERS_FOR_TOP_MATERIAL.set(null);
+        // Paper end - optimise chunk generation
         RuleEvaluator rule = ruleSource.compile(context);
         int blockX = pos.getX();
         int blockY = pos.getY();
@@ -302,6 +262,13 @@ public class MaterialSystem {
         context.updateXZ(blockX, blockZ, gradientX, gradientZ);
         context.updateY(1, 1, underFluid ? blockY + 1 : Integer.MIN_VALUE, blockY);
         BlockState state = rule.tryApply(blockX, blockY, blockZ);
+        // Paper start - optimise chunk generation
+        final ca.spottedleaf.moonrise.patches.chunk_gen.buffer_alloc.ThreadLocalFixedDensityBufferCache allocator = context.moonrise$removeDensityBufferAllocator();
+        if (allocator != null) {
+            allocator.release();
+            BUFFERS_FOR_TOP_MATERIAL.set(allocator);
+        }
+        // Paper end - optimise chunk generation
         return Optional.ofNullable(state);
