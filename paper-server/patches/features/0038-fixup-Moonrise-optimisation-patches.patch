             }
 
-            this.finishRead(compoundTag, throwable);
-            if (!this.tryAbortWrite()) {
+            final boolean cancelledWrite = this.finishRead(compoundTag, throwable);
+            if (!cancelledWrite) {
                 this.scheduleWriteCompress();
             }
         }
 
-        private void finishRead(final CompoundTag compoundTag, final Throwable throwable) {
-            this.inProgressRead.complete(this, compoundTag, throwable);
+        private boolean finishRead(final CompoundTag compoundTag, final Throwable throwable) {
+            final long chunkKey = CoordinateUtils.getChunkKey(this.chunkX, this.chunkZ);
+
+            final boolean[] canSingleComplete = new boolean[1];
+            final ChunkIOTask inMap = this.regionDataController.chunkTasks.compute(chunkKey, (final long keyInMap, final ChunkIOTask valueInMap) -> {
+                if (valueInMap == null) {
+                    throw new IllegalStateException("Read/write completed concurrently, expected this task: " + ChunkIOTask.this.toString() + ", report this!");
+                }
+                if (valueInMap != ChunkIOTask.this) {
+                    throw new IllegalStateException("Chunk task mismatch, expected this task: " + ChunkIOTask.this.toString() + ", got: " + valueInMap.toString() + ", report this!");
+                }
+
+                canSingleComplete[0] = valueInMap.inProgressRead.hasAtMostOneCallback();
+
+                if (valueInMap.inProgressWrite != null) {
+                    return valueInMap;
+                }
+
+                return null;
+            });
+
+            if (canSingleComplete[0]) {
+                this.inProgressRead.completeOne(this, compoundTag, throwable);
+            } else {
+                this.inProgressRead.complete(this, compoundTag, throwable);
+            }
+
+            if (inMap == null) {
+                this.regionDataController.endTask(this);
+                return true; // set the task value to null, indicating we're done
+            }
+            // else: inProgressWrite is present, indicating we need to write a value
+            return false;
         }
 
         public void scheduleWriteCompress() {
@@ -1180,7 +1218,7 @@ public final class MoonriseRegionFileIO {
                 this.currentTask = task;
             }
 
-            inProgressWrite.addToWaiters(this, (final CompoundTag data, final Throwable throwable) -> {
+            inProgressWrite.addToWaiters(this, (BiConsumer<CompoundTag, Throwable> & NoCopyNBTData) (final CompoundTag data, final Throwable throwable) -> {
                 task.queue();
             });
         }
@@ -1330,6 +1368,7 @@ public final class MoonriseRegionFileIO {
 
             private static final Logger LOGGER = LoggerFactory.getLogger(InProgressRead.class);
 
+            private boolean written;
             private CompoundTag value;
             private Throwable throwable;
             private final MultiThreadedQueue<BiConsumer<CompoundTag, Throwable>> callbacks = new MultiThreadedQueue<>();
@@ -1346,17 +1385,44 @@ public final class MoonriseRegionFileIO {
                 return this.callbacks.remove(callback);
             }
 
+            public boolean hasAtMostOneCallback() {
+                return this.callbacks.size() <= 1;
+            }
+
+            public void completeOne(final ChunkIOTask task, final CompoundTag value, final Throwable throwable) {
+                // since the task is either cancelled (removed) or has an in-progress write,
+                // we can guarantee that the read data is only used by one consumer - eliminating
+                // the need to copy
+
+                this.callbacks.preventAdds();
+
+                final BiConsumer<CompoundTag, Throwable> consumer = this.callbacks.poll();
+                if (consumer != null) {
+                    this.completeConsumer(task, consumer, value, throwable);
+
+                    if (!this.callbacks.isEmpty()) {
+                        throw new IllegalStateException("Expected only one callback");
+                    }
+                } // else: add blocked, we are done here
+            }
+
+            private void completeConsumer(final ChunkIOTask task, final BiConsumer<CompoundTag, Throwable> consumer, final CompoundTag value, final Throwable throwable) {
+                try {
+                    consumer.accept(value, throwable);
+                } catch (final Throwable thr) {
+                    LOGGER.error("Callback " + ConcurrentUtil.genericToString(consumer) + " failed to handle chunk data (read) for task " + task.toString(), thr);
+                }
+            }
+
             public void complete(final ChunkIOTask task, final CompoundTag value, final Throwable throwable) {
                 this.value = value;
                 this.throwable = throwable;
+                this.written = true;
 
                 BiConsumer<CompoundTag, Throwable> consumer;
                 while ((consumer = this.callbacks.pollOrBlockAdds()) != null) {
-                    try {
-                        consumer.accept(value == null ? null : value.copy(), throwable);
-                    } catch (final Throwable thr) {
-                        LOGGER.error("Callback " + ConcurrentUtil.genericToString(consumer) + " failed to handle chunk data (read) for task " + task.toString(), thr);
-                    }
+                    final boolean copy = !(consumer instanceof NoCopyNBTData);
+                    this.completeConsumer(task, consumer, value == null ? null : (copy ? value.copy() : value), throwable);
                 }
             }
         }
@@ -1398,7 +1464,8 @@ public final class MoonriseRegionFileIO {
 
             private void syncAccept(final ChunkIOTask task, final BiConsumer<CompoundTag, Throwable> consumer, final CompoundTag value, final Throwable throwable) {
                 try {
-                    consumer.accept(value == null ? null : value.copy(), throwable);
+                    final boolean copy = !(consumer instanceof NoCopyNBTData);
+                    consumer.accept(value == null ? null : (copy ? value.copy() : value), throwable);
                 } catch (final Throwable thr) {
                     LOGGER.error("Callback " + ConcurrentUtil.genericToString(consumer) + " failed to handle chunk data (write) for task " + task.toString(), thr);
                 }
@@ -1423,6 +1490,12 @@ public final class MoonriseRegionFileIO {
         }
     }
 
+    /**
+     * Use on callbacks indicating that the NBT data input is never modified. The callback is invoked
