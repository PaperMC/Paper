From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jason Penilla <11360596+jpenilla@users.noreply.github.com>
Date: Wed, 7 Oct 2026 17:15:37 -0700
Subject: [PATCH] fixup! Moonrise optimisation patches


diff --git a/net/minecraft/world/level/chunk/ChunkGenerator.java b/net/minecraft/world/level/chunk/ChunkGenerator.java
index bb484105c8bcbc277cd85b7d1168680bf0b1ce85..fdc5da6d47b68db76328bfea4cbef0cebe4280df 100644
--- a/net/minecraft/world/level/chunk/ChunkGenerator.java
+++ b/net/minecraft/world/level/chunk/ChunkGenerator.java
@@ -387,7 +387,17 @@ public abstract class ChunkGenerator {
                 ChunkAccess chunkInRange = level.getChunk(chunkPos.x(), chunkPos.z());
 
                 for (LevelChunkSection section : chunkInRange.getSections()) {
-                    section.getBiomes().getAll(possibleBiomes::add);
+                    // Paper start - optimise chunk generation
+                    // We do not need to search the entire biome section, as the biome section is never
+                    // modified after being created - meaning that the palette only contains entries
+                    // that are present in the section (provided that the palette is NOT global).
+                    final PalettedContainerRO<Holder<Biome>> biomes = section.getBiomes();
+                    if (((PalettedContainer<Holder<Biome>>)biomes).data.palette() instanceof GlobalPalette<Holder<Biome>>) {
+                        biomes.getAll(possibleBiomes::add);
+                    } else {
+                        biomes.forEachInPalette(possibleBiomes::add);
+                    }
+                    // Paper end - optimise chunk generation
                 }
             });
             possibleBiomes.retainAll(this.biomeSource.possibleBiomes());
